# Copy to .env (git-ignored) to override defaults. Put real keys ONLY in .env, never in this file.
SCRIBE_WHISPER_MODEL=small
SCRIBE_WHISPER_COMPUTE_TYPE=int8
SCRIBE_VAD_MIN_RMS=400
SCRIBE_VAD_NOISE_MULTIPLIER=3.0
SCRIBE_VAD_END_SILENCE_MS=700
SCRIBE_VAD_MIN_SPEECH_MS=300
SCRIBE_VAD_MAX_UTTERANCE_S=20
SCRIBE_PARTIAL_INTERVAL_S=1.5

# SQLite database for sessions and notes.
SCRIBE_DB_PATH=data/scribe.db

# LLM (any OpenAI-compatible API). Defaults to Google AI Studio (Gemini).
SCRIBE_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
SCRIBE_LLM_API_KEY=
SCRIBE_LLM_MODEL=
SCRIBE_LLM_TIMEOUT_S=60
SCRIBE_LLM_MAX_RETRIES=2
SCRIBE_LLM_REASONING_EFFORT=
